# Ferreteria API - Variables de entorno
# Copia este archivo a .env y ajusta los valores

# Aplicacion
APP_NAME="Ferreteria API"
APP_VERSION="1.0.0"
DEBUG=false

# Seguridad - CAMBIA ESTOS VALORES EN PRODUCCION
SECRET_KEY="cambia-esta-clave-por-una-segura-y-larga-generada-aleatoriamente"
ALGORITHM="HS256"
TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Base de datos
# SQLite (desarrollo): sqlite:///./ferreteria.db
# PostgreSQL (produccion): postgresql://user:pass@host:5432/dbname
DATABASE_URL="sqlite:///./ferreteria.db"

# CORS (orígenes permitidos, separados por comas)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Reglas de negocio / analitica
DIAS_VENTANA=30
DIAS_COBERTURA=7
DIAS_HISTORIAL_MINIMO=7

# Datos de prueba (solo para seed)
SEED_ADMIN_PASSWORD="admin123"
SEED_VENDEDOR_PASSWORD="vendedor123"

# Si es True y la base de datos esta vacia, se ejecuta el seed al arrancar
AUTO_SEED=false