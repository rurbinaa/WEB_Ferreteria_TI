# Copia este archivo a .env y ajusta los valores.
# NUNCA subas el .env real al repositorio.

# Clave secreta para firmar los JWT (genera una nueva: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esta-clave-en-produccion

# Base de datos (SQLite por defecto; para Postgres usa postgresql+psycopg://usuario:pass@host/db)
DATABASE_URL=sqlite:///./ferreteria.db

# Caducidad del token (minutos, por defecto 8 horas = 480)
TOKEN_EXPIRE_MINUTES=480

# Dias usados para calcular el promedio diario de ventas
DIAS_VENTANA=30

# Dias de cobertura para la recomendacion de reposicion
DIAS_COBERTURA=7

# Numero minimo de dias con historial para confianza "normal"
DIAS_HISTORIAL_MINIMO=7

# Origenes permitidos por CORS (separados por comas)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Intentos de login antes del bloqueo temporal
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# Contrasenas de los usuarios de prueba (seed)
SEED_ADMIN_PASSWORD=admin123
SEED_VENDEDOR_PASSWORD=vendedor123